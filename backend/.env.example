# ---- Application -------------------------------------------------------
APP_NAME=Cadence API
APP_ENV=development
DEBUG=true

# ---- Database ----------------------------------------------------------
# SQLite (zero setup, default)
DATABASE_URL=sqlite:///./cadence.db
# PostgreSQL (preferred for a shared environment)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cadence
SQL_ECHO=false

# ---- Security ----------------------------------------------------------
SECRET_KEY=replace-this-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- CORS (comma separated) -------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- External API integration -----------------------------------------
EXTERNAL_API_BASE_URL=https://jsonplaceholder.typicode.com
EXTERNAL_API_KEY=
EXTERNAL_API_TIMEOUT=8
EXTERNAL_API_RETRIES=2
EXTERNAL_API_CACHE_TTL=300
EXTERNAL_API_RATE_LIMIT=30

# ---- Demo data ---------------------------------------------------------
SEED_ON_STARTUP=true
DEFAULT_PASSWORD=password123
